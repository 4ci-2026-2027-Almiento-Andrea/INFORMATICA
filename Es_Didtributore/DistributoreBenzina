public class DistributoreBenzina {

    private double deposito;
    private double euroPerLitro;

    // costruttore senza parametri
    public DistributoreBenzina() {
        this.deposito = 0.0;
        this.euroPerLitro = 0.0;
    }

    // costruttore con parametri
    public DistributoreBenzina(double prezzo) {

        this.deposito = 0.0;

        if (prezzo > 0.0) {
            this.euroPerLitro = prezzo;
        }
        else {
            this.euroPerLitro = 0.0;
        }
    }

    // getter deposito
    public double getDeposito() {
        return this.deposito;
    }

    // setter deposito
    public void setDeposito(double quantita) {

        if (quantita >= 0.0) {
            this.deposito = quantita;
        }
       
    }

    // getter prezzo
    public double getEuroPerLitro() {
        return this.euroPerLitro;
    }

    // setter prezzo
    public void setEuroPerLitro(double prezzo) {

        if (prezzo > 0.0) {
            this.euroPerLitro = prezzo;
        }
       
    }

    // rifornisce il distributore
    public void rifornisci(double quantita) {

        if (quantita > 0.0) {
            this.deposito += quantita;
        }
        else {
            System.out.println("La quantita deve essere maggiore di 0");
        }
    }

    // vende benzina alla macchina
    public void vendi(double euro, Car automobile) {

        if (euro > 0.0) {

            if (automobile != null) {

                if (this.euroPerLitro > 0.0) {

                    double quantita = euro / this.euroPerLitro;

                    if (quantita <= this.deposito) {

                        this.deposito -= quantita;
                        automobile.addGas(quantita);

                    }
                    
                }
                
            }
            
        }
        
    }

    // aggiorna il prezzo
    public void aggiorna(double prezzo) {

        if (prezzo > 0.0) {
            this.euroPerLitro = prezzo;
        }
        
    }

    // toString
    public String toString() {
        return "deposito: " + this.deposito +
               "\n euro per litro: " + this.euroPerLitro;
    }
}
